{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@meromiti/core": ["packages/core/src/index.ts"],
      "@meromiti/web": ["packages/web/src/index.ts"],
      "@meromiti/web/*": ["packages/web/src/*"],
      "@meromiti/react": ["packages/react/src/index.ts"],
      "@meromiti/vue": ["packages/vue/src/index.ts"],
      "@meromiti/angular": ["packages/angular/src/public-api.ts"],
      "@meromiti/react-native": ["packages/react-native/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*"
  ]
}
