<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>MeroMiti</PackageId>
    <Version>1.0.0</Version>
    <Authors>Inline Tech Solution</Authors>
    <Company>Inline Tech Solution</Company>
    <Description>Universal Bikram Sambat (B.S.) Nepali calendar engine and date converter for .NET, C#, and ASP.NET Core.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/inlinetechsolution/mero-miti</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inlinetechsolution/mero-miti.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nepali;calendar;bikram-sambat;date;datepicker;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
